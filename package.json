{
  "name": "voxmixture",
  "version": "0.1.0",
  "type": "module",
  "description": "Mix many voices into one episode: dialogue script to TTS to loudness-balanced audio.",
  "license": "MIT",
  "keywords": ["tts", "podcast", "elevenlabs", "openai", "ffmpeg", "bun", "loudness"],
  "engines": {
    "bun": ">=1.1"
  },
  "bin": {
    "voxmixture": "src/app/cli.ts"
  },
  "scripts": {
    "start": "bun src/app/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun verify/verify-sim.ts"
  },
  "dependencies": {
    "chalk": "^5",
    "openai": "^4",
    "p-limit": "^6",
    "remeda": "^2",
    "yaml": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bun-types": "latest",
    "typescript": "^5",
    "vitest": "^3"
  }
}
